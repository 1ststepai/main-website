{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1ststep.ai/schemas/os-contract.v1.schema.json",
  "title": "1stStep OS proposed entity contract v1",
  "description": "Draft shapes only; persistence, authorization, state transitions and retention require service enforcement and owner approval.",
  "oneOf": [
    { "$ref": "#/$defs/User" }, { "$ref": "#/$defs/Organization" }, { "$ref": "#/$defs/OrganizationMembership" }, { "$ref": "#/$defs/Portfolio" }, { "$ref": "#/$defs/ProjectMembership" }, { "$ref": "#/$defs/Project" }, { "$ref": "#/$defs/ProjectRegistryRecord" },
    { "$ref": "#/$defs/ProjectProfile" }, { "$ref": "#/$defs/ProjectGenome" }, { "$ref": "#/$defs/GenomeSignal" },
    { "$ref": "#/$defs/CapabilitySelection" }, { "$ref": "#/$defs/Answer" }, { "$ref": "#/$defs/Recommendation" },
    { "$ref": "#/$defs/Evidence" }, { "$ref": "#/$defs/Decision" }, { "$ref": "#/$defs/ProjectOSManifest" },
    { "$ref": "#/$defs/ProjectOSArtifact" }, { "$ref": "#/$defs/Connection" }, { "$ref": "#/$defs/AuditRun" },
    { "$ref": "#/$defs/AutomationOpportunity" }, { "$ref": "#/$defs/DiscoveryProfile" }, { "$ref": "#/$defs/AgentJob" },
    { "$ref": "#/$defs/Checkpoint" }, { "$ref": "#/$defs/Handoff" }, { "$ref": "#/$defs/ResearchClaim" },
    { "$ref": "#/$defs/BaselineSnapshot" }, { "$ref": "#/$defs/AuditFinding" }, { "$ref": "#/$defs/ReleaseRecord" }, { "$ref": "#/$defs/OutcomeObservation" }, { "$ref": "#/$defs/PatternDefinition" }, { "$ref": "#/$defs/PortfolioCommandCenterSnapshot" }, { "$ref": "#/$defs/UniversalTaskEnvelope" }
  ],
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "time": { "type": "string", "format": "date-time" },
    "ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["UNKNOWN", "INFERRED", "RECOMMENDED", "CONFIRMED", "OBSERVED", "VERIFIED", "CONTRADICTED", "STALE"] },
    "confidence": { "enum": ["UNKNOWN", "LOW", "MEDIUM", "HIGH"] },
    "sourceClass": { "enum": ["UNKNOWN", "USER_PROVIDED", "REPOSITORY_OBSERVED", "EXTERNAL_RESEARCH", "BUSINESS_SYSTEM_OBSERVED", "PUBLIC_PRODUCT_OBSERVED", "INFERENCE", "ASSUMPTION"] },
    "entity": {
      "type": "object",
      "required": ["entityType", "schemaVersion", "id", "createdAt", "updatedAt"],
      "properties": { "entityType": { "type": "string" }, "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "organizationId": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/id" }, "createdAt": { "$ref": "#/$defs/time" }, "updatedAt": { "$ref": "#/$defs/time" }, "revision": { "type": "integer", "minimum": 1 } }
    },
    "Fact": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "source", "confidence", "status", "observedAt"],
      "properties": { "value": { "type": ["string", "number", "boolean", "array", "object", "null"] }, "source": { "$ref": "#/$defs/sourceClass" }, "confidence": { "$ref": "#/$defs/confidence" }, "status": { "$ref": "#/$defs/status" }, "observedAt": { "$ref": "#/$defs/time" }, "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } },
      "allOf": [
        { "if": { "properties": { "status": { "const": "UNKNOWN" } } }, "then": { "properties": { "value": { "type": "null" }, "source": { "const": "UNKNOWN" }, "confidence": { "const": "UNKNOWN" } } } },
        { "if": { "properties": { "status": { "const": "INFERRED" } } }, "then": { "properties": { "source": { "const": "INFERENCE" } } } }
      ]
    },
    "User": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["identitySubject", "state"], "properties": { "entityType": { "const": "User" }, "identitySubject": { "$ref": "#/$defs/ref" }, "state": { "enum": ["ACTIVE", "DISABLED"] } } }] },
    "Organization": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["name", "ownerUserId"], "properties": { "entityType": { "const": "Organization" }, "name": { "type": "string", "minLength": 1 }, "ownerUserId": { "$ref": "#/$defs/id" } } }] },
    "OrganizationMembership": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "userId", "role", "status"], "properties": { "entityType": { "const": "OrganizationMembership" }, "userId": { "$ref": "#/$defs/id" }, "role": { "enum": ["OWNER", "ADMIN", "EDITOR", "VIEWER"] }, "status": { "enum": ["ACTIVE", "REVOKED"] } } }] },
    "Portfolio": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "name", "slug", "revision"], "properties": { "entityType": { "const": "Portfolio" }, "name": { "type": "string", "minLength": 1 }, "slug": { "$ref": "#/$defs/ref" } } }] },
    "ProjectMembership": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "userId", "role", "status"], "properties": { "entityType": { "const": "ProjectMembership" }, "userId": { "$ref": "#/$defs/id" }, "role": { "enum": ["OWNER", "ADMIN", "EDITOR", "VIEWER"] }, "status": { "enum": ["ACTIVE", "REVOKED"] } } }] },
    "Project": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "portfolioId", "ownerUserId", "name", "slug", "startingState", "lifecycle", "revision"], "properties": { "entityType": { "const": "Project" }, "portfolioId": { "$ref": "#/$defs/id" }, "ownerUserId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "slug": { "$ref": "#/$defs/ref" }, "startingState": { "enum": ["IDEA", "EXISTING_BUILD", "BUSINESS", "NEED_USERS", "UNSURE"] }, "lifecycle": { "enum": ["DRAFT", "ACTIVE", "ARCHIVED"] } } }] },
    "ProjectRegistryRecord": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "portfolioId", "projectId", "name", "slug", "sourceRevisions", "facts", "health", "openCriticalFindings", "openHighFindings", "lastVerified", "currentNextAction"], "properties": { "entityType": { "const": "ProjectRegistryRecord" }, "portfolioId": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "slug": { "$ref": "#/$defs/ref" }, "sourceRevisions": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "facts": { "type": "object", "required": ["canonicalUrl", "repository", "productType", "stage", "platforms", "stack", "auth", "database", "payments", "aiProviders", "deployment", "analytics", "businessModel", "growthModel", "publicStatus", "releaseStatus", "auditStatus", "currentGenomeVersion", "currentProjectOSVersion"], "propertyNames": { "enum": ["canonicalUrl", "repository", "productType", "stage", "platforms", "stack", "auth", "database", "payments", "aiProviders", "deployment", "analytics", "businessModel", "growthModel", "publicStatus", "releaseStatus", "auditStatus", "currentGenomeVersion", "currentProjectOSVersion"] }, "additionalProperties": { "$ref": "#/$defs/Fact" } }, "health": { "type": "object", "required": ["product", "engineering", "security", "testing", "design", "aiEfficiency", "business", "discovery", "growth", "operations", "releaseReadiness"], "propertyNames": { "enum": ["product", "engineering", "security", "testing", "design", "aiEfficiency", "business", "discovery", "growth", "operations", "releaseReadiness"] }, "additionalProperties": { "$ref": "#/$defs/Fact" } }, "openCriticalFindings": { "$ref": "#/$defs/Fact" }, "openHighFindings": { "$ref": "#/$defs/Fact" }, "lastVerified": { "$ref": "#/$defs/Fact" }, "currentNextAction": { "$ref": "#/$defs/Fact" } } }] },
    "ProjectProfile": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "revision", "goal", "startingState"], "properties": { "entityType": { "const": "ProjectProfile" }, "goal": { "$ref": "#/$defs/Fact" }, "startingState": { "$ref": "#/$defs/Fact" }, "narrative": { "type": "string" }, "answerIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "ProjectGenome": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "revision", "policyVersion", "inputRevisions", "signalIds"], "properties": { "entityType": { "const": "ProjectGenome" }, "policyVersion": { "$ref": "#/$defs/ref" }, "inputRevisions": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "signalIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "GenomeSignal": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "genomeId", "key", "fact"], "properties": { "entityType": { "const": "GenomeSignal" }, "genomeId": { "$ref": "#/$defs/id" }, "key": { "$ref": "#/$defs/ref" }, "fact": { "$ref": "#/$defs/Fact" }, "contradictionEvidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "CapabilitySelection": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "genomeId", "capabilityKey", "state", "reason"], "properties": { "entityType": { "const": "CapabilitySelection" }, "genomeId": { "$ref": "#/$defs/id" }, "capabilityKey": { "$ref": "#/$defs/ref" }, "state": { "enum": ["ACTIVE", "DORMANT", "BLOCKED"] }, "reason": { "type": "string" } } }] },
    "Answer": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "questionId", "value", "answerStatus", "actorUserId"], "properties": { "entityType": { "const": "Answer" }, "questionId": { "$ref": "#/$defs/ref" }, "value": { "type": ["string", "number", "boolean", "null"] }, "answerStatus": { "enum": ["PROVIDED", "I_DONT_KNOW", "RECOMMEND_FOR_ME"] }, "actorUserId": { "$ref": "#/$defs/id" }, "supersedesAnswerId": { "$ref": "#/$defs/id" } }, "allOf": [{ "if": { "properties": { "answerStatus": { "enum": ["I_DONT_KNOW", "RECOMMEND_FOR_ME"] } } }, "then": { "properties": { "value": { "type": "null" } } } }] }] },
    "Recommendation": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "title", "reason", "status", "sourceClass", "confidence", "inputRevisions"], "properties": { "entityType": { "const": "Recommendation" }, "title": { "type": "string" }, "reason": { "type": "string" }, "status": { "enum": ["PROPOSED", "ACCEPTED", "CHANGED", "REJECTED", "STALE"] }, "sourceClass": { "$ref": "#/$defs/sourceClass" }, "confidence": { "$ref": "#/$defs/confidence" }, "inputRevisions": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "expiresAt": { "$ref": "#/$defs/time" } } }] },
    "Evidence": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "sourceClass", "locator", "digest", "observedAt", "scope", "accessState"], "properties": { "entityType": { "const": "Evidence" }, "sourceClass": { "$ref": "#/$defs/sourceClass" }, "locator": { "$ref": "#/$defs/ref" }, "digest": { "$ref": "#/$defs/ref" }, "observedAt": { "$ref": "#/$defs/time" }, "scope": { "type": "string" }, "accessState": { "enum": ["AUTHORIZED", "PUBLIC", "REVOKED", "UNKNOWN"] }, "redactionState": { "enum": ["NONE", "REDACTED", "QUARANTINED"] } } }] },
    "Decision": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "actorUserId", "decisionType", "status", "targetRevision"], "properties": { "entityType": { "const": "Decision" }, "actorUserId": { "$ref": "#/$defs/id" }, "decisionType": { "enum": ["ACCEPT", "CHANGE", "REJECT", "APPROVE_ACTION"] }, "status": { "enum": ["ACTIVE", "STALE", "SUPERSEDED"] }, "targetRevision": { "$ref": "#/$defs/ref" }, "recommendationId": { "$ref": "#/$defs/id" }, "rationale": { "type": "string" } } }] },
    "ProjectOSManifest": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "compilerVersion", "inputRevisions", "artifactIds", "status", "digest"], "properties": { "entityType": { "const": "ProjectOSManifest" }, "compilerVersion": { "$ref": "#/$defs/ref" }, "inputRevisions": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "artifactIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "status": { "enum": ["GENERATING", "VALIDATED", "FAILED", "STALE"] }, "digest": { "$ref": "#/$defs/ref" } } }] },
    "ProjectOSArtifact": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "manifestId", "path", "digest", "templateVersion", "authority", "provenance", "generatedAt", "dependencyIds", "regenerationRule"], "properties": { "entityType": { "const": "ProjectOSArtifact" }, "manifestId": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/ref" }, "digest": { "$ref": "#/$defs/ref" }, "templateVersion": { "$ref": "#/$defs/ref" }, "authority": { "enum": ["PROPOSED", "HUMAN_APPROVED", "SYSTEM_POLICY"] }, "provenance": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "generatedAt": { "$ref": "#/$defs/time" }, "dependencyIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "regenerationRule": { "type": "string" } } }] },
    "Connection": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "provider", "installationRef", "repositoryId", "permissionSnapshot", "status"], "properties": { "entityType": { "const": "Connection" }, "provider": { "const": "GITHUB" }, "installationRef": { "$ref": "#/$defs/ref" }, "repositoryId": { "$ref": "#/$defs/ref" }, "permissionSnapshot": { "type": "object" }, "status": { "enum": ["PENDING", "ACTIVE", "REVOKED", "ERROR"] } } }] },
    "AuditRun": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "baselineId", "genomeId", "controlSetVersion", "status", "findingIds"], "properties": { "entityType": { "const": "AuditRun" }, "baselineId": { "$ref": "#/$defs/id" }, "genomeId": { "$ref": "#/$defs/id" }, "controlSetVersion": { "$ref": "#/$defs/ref" }, "status": { "enum": ["QUEUED", "RUNNING", "COMPLETED", "PARTIAL", "FAILED"] }, "findingIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "AutomationOpportunity": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "process", "currentHumanEffort", "systemsInvolved", "candidate", "risk", "estimatedEffort", "estimatedCost", "estimatedTimeSaved", "roiConfidence", "requiredIntegrations"], "properties": { "entityType": { "const": "AutomationOpportunity" }, "process": { "$ref": "#/$defs/Fact" }, "currentHumanEffort": { "$ref": "#/$defs/Fact" }, "systemsInvolved": { "type": "array", "items": { "$ref": "#/$defs/Fact" } }, "candidate": { "$ref": "#/$defs/Fact" }, "risk": { "$ref": "#/$defs/Fact" }, "estimatedEffort": { "$ref": "#/$defs/Fact" }, "estimatedCost": { "$ref": "#/$defs/Fact" }, "estimatedTimeSaved": { "$ref": "#/$defs/Fact" }, "roiConfidence": { "$ref": "#/$defs/confidence" }, "requiredIntegrations": { "type": "array", "items": { "type": "string" } } } }] },
    "DiscoveryProfile": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "revision", "dimensions"], "properties": { "entityType": { "const": "DiscoveryProfile" }, "dimensions": { "type": "object", "propertyNames": { "enum": ["positioning", "seo", "technicalSeo", "content", "entityAuthority", "aeo", "geo", "llmVisibility", "aiAnswerability", "citations", "directories", "reviews", "social", "youtube", "appStores", "conversion", "analytics"] }, "additionalProperties": { "$ref": "#/$defs/Fact" } } } }] },
    "AgentJob": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "taskEnvelopeId", "status", "completedUnits", "remainingUnits", "budgetUsed", "budgetCeiling", "nextAction"], "properties": { "entityType": { "const": "AgentJob" }, "taskEnvelopeId": { "$ref": "#/$defs/id" }, "provider": { "type": ["string", "null"] }, "model": { "type": ["string", "null"] }, "status": { "enum": ["RUNNING", "CHECKPOINTING", "PAUSED_USAGE_LIMIT", "PAUSED_RATE_LIMIT", "PAUSED_CONTEXT_LIMIT", "PAUSED_USER", "PAUSED_ERROR", "RESUME_READY", "BLOCKED", "COMPLETED"] }, "completedUnits": { "type": "integer", "minimum": 0 }, "remainingUnits": { "type": "integer", "minimum": 0 }, "checkpointId": { "$ref": "#/$defs/id" }, "nextAction": { "type": "string" }, "budgetUsed": { "type": "number", "minimum": 0 }, "budgetCeiling": { "type": "number", "minimum": 0 }, "pauseReason": { "type": ["string", "null"] }, "resumeNotBefore": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] } } }] },
    "Checkpoint": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "jobId", "inputRevisions", "completedArtifactDigests", "remainingWork", "budgetUsed", "nextAction"], "properties": { "entityType": { "const": "Checkpoint" }, "jobId": { "$ref": "#/$defs/id" }, "inputRevisions": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "completedArtifactDigests": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "remainingWork": { "type": "array", "items": { "type": "string" } }, "budgetUsed": { "type": "number", "minimum": 0 }, "nextAction": { "type": "string" } } }] },
    "Handoff": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "fromOwner", "toOwner", "envelopeId", "status", "acceptanceCriteria"], "properties": { "entityType": { "const": "Handoff" }, "fromOwner": { "$ref": "#/$defs/ref" }, "toOwner": { "$ref": "#/$defs/ref" }, "envelopeId": { "$ref": "#/$defs/id" }, "status": { "enum": ["PROPOSED", "ACCEPTED", "BLOCKED", "COMPLETED"] }, "acceptanceCriteria": { "type": "array", "items": { "type": "string" } } } }] },
    "ResearchClaim": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "claim", "sourceClass", "sourceReference", "retrievedAt", "freshness", "confidence", "scope", "contradictionIds", "verificationState"], "properties": { "entityType": { "const": "ResearchClaim" }, "claim": { "type": "string" }, "sourceClass": { "$ref": "#/$defs/sourceClass" }, "sourceReference": { "$ref": "#/$defs/ref" }, "retrievedAt": { "$ref": "#/$defs/time" }, "freshness": { "enum": ["CURRENT", "STALE", "UNKNOWN"] }, "confidence": { "$ref": "#/$defs/confidence" }, "scope": { "type": "string" }, "contradictionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "verificationState": { "enum": ["UNVERIFIED", "VERIFIED", "CONTRADICTED"] } } }] },
    "BaselineSnapshot": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "connectionId", "repositoryId", "branch", "commitSha", "dirtyState", "capturedAt", "stackInventory", "dependencyInventory", "testState", "buildState", "deploymentEvidenceIds", "externalEvidenceIds", "genomeId", "status", "digest"], "properties": { "entityType": { "const": "BaselineSnapshot" }, "connectionId": { "$ref": "#/$defs/id" }, "repositoryId": { "$ref": "#/$defs/ref" }, "branch": { "$ref": "#/$defs/ref" }, "commitSha": { "$ref": "#/$defs/ref" }, "dirtyState": { "enum": ["CLEAN", "DIRTY", "UNKNOWN", "NOT_APPLICABLE"] }, "capturedAt": { "$ref": "#/$defs/time" }, "stackInventory": { "type": "array", "items": { "type": "string" } }, "dependencyInventory": { "type": "array", "items": { "type": "string" } }, "testState": { "enum": ["NOT_RUN", "PASS", "FAIL", "UNKNOWN"] }, "buildState": { "enum": ["NOT_RUN", "PASS", "FAIL", "UNKNOWN"] }, "deploymentEvidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "externalEvidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "genomeId": { "$ref": "#/$defs/id" }, "status": { "enum": ["DRAFT", "SEALED", "INCOMPLETE"] }, "digest": { "$ref": "#/$defs/ref" } } }] },
    "AuditFinding": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "auditRunId", "controlKey", "domain", "severity", "priority", "status", "evidenceIds", "evidenceStrength", "impact", "recommendation", "verificationRequirement"], "properties": { "entityType": { "const": "AuditFinding" }, "auditRunId": { "$ref": "#/$defs/id" }, "controlKey": { "$ref": "#/$defs/ref" }, "domain": { "$ref": "#/$defs/ref" }, "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"] }, "priority": { "enum": ["P0", "P1", "P2", "P3", "UNPRIORITIZED"] }, "status": { "enum": ["NOT_ASSESSED", "OPEN", "REMEDIATED", "VERIFIED", "REOPENED"] }, "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "evidenceStrength": { "$ref": "#/$defs/confidence" }, "impact": { "type": "string" }, "recommendation": { "type": "string" }, "verificationRequirement": { "type": "string" } } }] },
    "ReleaseRecord": { "allOf": [{ "$ref": "#/$defs/entity" }, { "type": "object", "required": ["organizationId", "projectId", "status", "target", "evidenceIds", "verifiedAt"], "properties": { "entityType": { "const": "ReleaseRecord" }, "status": { "enum": ["PLANNED", "CANDIDATE", "DEPLOYED", "PRODUCTION_VERIFIED", "BLOCKED", "UNKNOWN"] }, "target": { "$ref": "#/$defs/Fact" }, "commitRef": { "$ref": "#/$defs/Fact" }, "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "verifiedAt": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] } } }] },
