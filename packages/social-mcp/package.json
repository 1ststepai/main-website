{
  "name": "@1ststep/social-mcp",
  "version": "0.1.0",
  "description": "PostPath by 1stStep.ai — one desk on your computer for social posts. Ask your assistant for posts; they land as drafts for each network, and nothing goes out until you approve it. Social logins stay encrypted locally, never sent to 1stStep, and go only to the network you connect or post to. Early access.",
  "private": true,
  "type": "module",
  "bin": {
    "social-mcp": "./bin/social-mcp.js",
    "postpath": "./bin/social-mcp.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js"
  },
  "scripts": {
    "start": "node ./bin/social-mcp.js app",
    "app": "node ./bin/social-mcp.js app",
    "mcp": "node ./bin/social-mcp.js serve",
    "test": "node --test test/*.test.js",
    "check": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "social",
    "youtube",
    "instagram",
    "facebook",
    "tiktok",
    "linkedin",
    "x",
    "threads",
    "pinterest",
    "bluesky",
    "reddit",
    "oauth",
    "local-first"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
