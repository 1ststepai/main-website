APP_IDEA_FORWARDING_ENABLED=false
APP_ALLOWED_ORIGINS=https://1ststep.ai,https://www.1ststep.ai,https://main-website-repo.vercel.app
APP_IDEA_RATE_LIMIT_MAX=12
APP_IDEA_RATE_LIMIT_WINDOW_MS=600000
APP_IDEA_RETENTION_SECONDS=7776000
APP_IDEA_GHL_WEBHOOK_URL=
APP_IDEA_ZAPIER_WEBHOOK_URL=
APP_IDEA_MAKE_WEBHOOK_URL=
APP_IDEA_CUSTOM_WEBHOOK_URL=

# Resend delivers App Idea Checker reports and Website Fit Check requests.
# The Fit Check endpoint fails closed when these values are not configured.
RESEND_API_KEY=
APP_IDEA_NOTIFY_TO=
APP_IDEA_NOTIFY_FROM=
MORRIS_COUNTY_OFFER_OPEN=true

# Shared secret for the confirmed-booking workflow webhook from LeadConnector.
# Send it as Authorization: Bearer <secret> or x-leadconnector-webhook-secret.
LEADCONNECTOR_ANALYTICS_WEBHOOK_SECRET=

# Optional Vercel KV storage. If omitted, another delivery path (Resend or an
# enabled webhook) must succeed or the API returns 503 instead of claiming save success.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional live Google reviews on the homepage. If omitted, the site shows a safe review CTA fallback.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Owner-only 1stStep Studio access. Production fails closed unless the
# one-way password hash and authenticator MFA are configured.
FIRSTSTEP_ADMIN_REQUIRE_PASSWORD_HASH=true
FIRSTSTEP_ADMIN_PASSWORD_HASH=
FIRSTSTEP_ADMIN_REQUIRE_MFA=true
FIRSTSTEP_ADMIN_TOTP_SECRET=
FIRSTSTEP_ADMIN_SESSION_SECRET=
# Dedicated server-to-server secret used only to read aggregate Job Agent
# operations from app.1ststep.ai. Configure the same 32+ character Sensitive
# value in the Job Agent Vercel project; never expose it to browser code.
JOB_AGENT_OPERATOR_BRIDGE_SECRET=
# Mobile admin sign-in can use only the authenticator code when MFA is configured.
# Set false to require the owner password on mobile too.
FIRSTSTEP_ADMIN_MOBILE_TOTP_LOGIN=true

# AES-256-GCM encryption for client workspaces and persisted lead intakes.
# Use a random 64-character hexadecimal value. During key rotation only, put
# the old key in FIRSTSTEP_DATA_ENCRYPTION_KEY_PREVIOUS until all data is saved
# again with the active key.
FIRSTSTEP_DATA_ENCRYPTION_KEY=
FIRSTSTEP_DATA_ENCRYPTION_KEY_PREVIOUS=

# Local-development compatibility only. Do not configure this in production.
FIRSTSTEP_ADMIN_PASSWORD=

# Admin quotes use the existing RESEND_API_KEY and send as:
# Evan at 1stStep.ai <evan@1ststep.ai>
# The 1ststep.ai domain must be verified in Resend before production delivery.

# Stripe-hosted, single-use payment links for quote installments. Card details
# stay with Stripe. Leave blank to keep payment-link creation fail-closed.
STRIPE_SECRET_KEY=
